# Add to /etc/datadog-agent/datadog.yaml on the SNMP relay host.

# Resolve ENC[...] handles from AWS Secrets Manager (the relay host's IAM role
# / IAM Roles Anywhere identity must allow secretsmanager:GetSecretValue on
# pki/snmp/*).
# Agent 7.70+ ships built-in secret backends (secret_backend_type). On older
# Agents use the open-source "datadog-secret-backend" binary through
# secret_backend_command instead. Check the handle syntax for your Agent
# version (here ENC[<secret name>;<json key>]).
secret_backend_type: aws.secrets
secret_backend_config:
  aws_session:
    aws_region: ca-central-1

# Receive SNMP traps (authenticationFailure, hardware alarms) - SNMPv3 users only.
network_devices:
  namespace: hsm
  snmp_traps:
    enabled: true
    port: 9162
    users:
      - user: dd-traps
        authKey: "ENC[pki/snmp/traps;auth_key]"
        authProtocol: SHA256
        privKey: "ENC[pki/snmp/traps;priv_key]"
        privProtocol: AES

logs_enabled: true
