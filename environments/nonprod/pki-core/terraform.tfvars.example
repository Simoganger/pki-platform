# Copy the values into the HCP Terraform workspace variables (preferred) or
# into terraform.auto.tfvars for local experiments. Never commit real e-mails
# of individuals or webhook URLs: use distribution lists and sensitive variables.

owner_email       = "pki-team@example.com"
organization_name = "Example Bank"

# crl_hostname           = "crl.pki-nonprod.example.com"
# public_route53_zone_id = "Z0123456789ABCDEFGHIJ"

alert_emails = ["pki-team@example.com"]

issuing_cas = {
  servers-issuing-g1 = {
    usage       = "tls-server"
    common_name = "Example Bank NonProd Servers Issuing CA G1"
    # Generated by: python scripts/build_name_constraints.py --permit .nonprod.internal.example.com
    # name_constraints_der_base64 = "..."
    ocsp_enabled = true
    share_with   = ["arn:aws:organizations::111111111111:ou/o-abc123/ou-abcd-11111111"]
  }

  workloads-mtls-g1 = {
    usage               = "mtls-workload"
    usage_mode          = "SHORT_LIVED_CERTIFICATE"
    common_name         = "Example Bank NonProd Workloads mTLS CA G1"
    crl_expiration_days = 1
    share_with          = ["arn:aws:organizations::111111111111:ou/o-abc123/ou-abcd-22222222"]
  }

  windows-issuing-g1 = {
    usage       = "windows-autoenroll"
    common_name = "Example Bank NonProd Windows Issuing CA G1"
    # Windows clients and older appliances: RSA is still the safest choice.
    key_algorithm     = "RSA_2048"
    signing_algorithm = "SHA256WITHRSA"
  }
}

